# Copy to .env. Fill in ONE main provider (A or B) for triage/classification,
# plus optionally a search provider for live verification (C) — Claude alone
# (B with no C) can triage and classify but has no web-search step wired up.

# ── Option A: Groq (free, no card required) ───────────────────────────────────
# Sign up at https://console.groq.com/keys to get a key instantly, free.
# If GROQ_API_KEY is set, it's used and ANTHROPIC_API_KEY is ignored.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Option B: Anthropic Claude (paid) ──────────────────────────────────────────
# Used instead of Groq for triage/classification if GROQ_API_KEY above is not
# set — this is the reference product's own main provider.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5

# ── Option C: Perplexity (live-search verification) ───────────────────────────
# Preferred whenever set, independent of whether A or B above is doing
# triage/classification — the same Claude + Perplexity pairing the reference
# product itself uses for verification. Sign up at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# Fallback search model used for live verification only when
# PERPLEXITY_API_KEY isn't set and the main provider (above) is Groq.
# groq/compound (the full model) reliably fails with a 413 "Request Entity
# Too Large" the instant it actually invokes web search on the free/on_demand
# tier — its search payload appears to exceed a request-size limit at that
# tier, independent of quota, topic, or API key. groq/compound-mini does the
# same job with a lighter search payload and works reliably. See
# scripts/llm_client.py's verify_with_search() and MAX_LIVE_SEARCHES below.
GROQ_SEARCH_MODEL=groq/compound-mini

# Max number of sections per document that get a live search-verification call.
# The reference product caps at ~10 searches/doc; we default lower still —
# the search provider's free-tier daily quota is tight enough that even light
# testing can exhaust it (see ARCHITECTURE.md §10b). Raise this once you have
# your own key with headroom, or if you're on a paid tier.
MAX_LIVE_SEARCHES=2

# Hard cap: uploads above this are rejected (instantly if declared via Content-Length,
# otherwise aborted mid-transfer as soon as the running total crosses it).
MAX_UPLOAD_MB=15

# Soft threshold: uploads at or above this size get a "this may take a moment" warning
# but are still processed normally.
LARGE_FILE_WARN_MB=5

# Server port
PORT=8000

# Comma-separated origins allowed to call this API via CORS (e.g. the React
# client's Vite dev server). Defaults cover Vite's default dev ports (5173,
# and 5174 for when 5173 is already taken) already.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ── Direct-to-S3 chunked upload (Server/scripts/s3_storage.py) ────────────────
# Large files (video, big PDFs, etc.) upload straight from the browser to S3
# via presigned multipart-upload URLs — this server only issues the URLs and
# never buffers the bytes, so upload size isn't bounded by server memory.
#
# For local dev, run a mock S3 server so this works with no AWS account:
#   pip install -r requirements.txt   # pulls in moto[s3,server]
#   moto_server -p 5001
# then leave S3_ENDPOINT_URL below pointed at it. To use real AWS instead,
# unset S3_ENDPOINT_URL, set real AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY,
# and pre-create S3_BUCKET with a CORS policy allowing PUT from CORS_ORIGINS
# above and exposing the ETag header (the browser needs to read it to finish
# the upload) — see README's "Direct-to-S3 uploads" section.
AWS_REGION=us-east-1
S3_BUCKET=clinsync-uploads
S3_ENDPOINT_URL=http://127.0.0.1:5001
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Size of each uploaded part/chunk. S3 requires >= 5 MB for every part but the
# last, which is enforced regardless of this value.
UPLOAD_PART_SIZE_MB=8

# How long a presigned part-upload URL stays valid before the browser must
# request a fresh one.
PRESIGN_EXPIRES_SECONDS=3600

# Hard cap on declared file size for the direct-to-S3 path — much higher than
# MAX_UPLOAD_MB above since these bytes never pass through this server.
MAX_CLOUD_UPLOAD_MB=5120
